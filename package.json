{
  "name": "@magic/format",
  "version": "0.0.75",
  "description": "format your code.",
  "homepage": "https://magic.github.io/format",
  "bugs": {
    "url": "https://github.com/magic/format/issues"
  },
  "license": "AGPL-3.0",
  "author": "Wizards & Witches",
  "contributors": [
    {
      "name": "jascha ehrenreich",
      "github": "jaeh"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magic/format.git"
  },
  "bin": {
    "f": "src/bin.js",
    "format": "src/bin.js"
  },
  "files": [
    "src",
    "types"
  ],
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./bin": "./src/bin.js",
    "./config": "./src/oxfmt.config.js",
    "./types": "./types/"
  },
  "scripts": {
    "start": "t --exclude test --exclude '**/*.d.ts'",
    "build": "tsc && npm run format",
    "tsc": "tsc --noEmit",
    "build:docs": "NODE_ENV=production magic build",
    "prod": "NODE_ENV=production magic build serve",
    "clean": "magic clean",
    "serve": "magic serve",
    "dev": "magic dev",
    "test": "t --exclude test --exclude '**/*.d.ts'",
    "format": "node src/bin.js f -w --exclude docs/ --exclude types/",
    "format:check": "node src/bin.js f --exclude docs/ --exclude types/",
    "calls": "calls",
    "lint": "oxlint"
  },
  "dependencies": {
    "@magic/cli": "0.0.55",
    "@magic/deep": "0.1.22",
    "@magic/fs": "0.0.40",
    "@magic/log": "0.1.23",
    "@magic/types": "0.1.40",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0"
  },
  "devDependencies": {
    "@magic-modules/git-badges": "0.0.12",
    "@magic-modules/light-switch": "0.0.12",
    "@magic-modules/no-spy": "0.0.9",
    "@magic-modules/pre": "0.0.12",
    "@magic-themes/docs": "0.0.15",
    "@magic/core": "0.0.161",
    "@magic/test": "0.3.51",
    "@types/node": "26.6.6",
    "typescript": "npm:@typescript/typescript6"
  },
  "engines": {
    "node": ">=14.15.4"
  },
  "engineStrict": true,
  "allowScripts": {
    "canvas@3.2.3": true,
    "@swc/core@1.15.47": true
  }
}
